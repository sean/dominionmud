# C compiler to use
CC = gcc

# Any special flags you want to pass to the compiler
MYFLAGS = -Wall

# flags for profiling (see hacker.doc for more information)
PROFILE = 

# libraries
LIBS = 

##############################################################################
# Do Not Modify Anything Below This Line (unless you know what you're doing) #
##############################################################################

CFLAGS = -g -O2 $(MYFLAGS) $(PROFILE)

OBJFILES = comm.o act_comm.o act_info.o act_item.o act_move.o \
	act_off.o act_othr.o act_socl.o act_wizd.o alias.o \
	ban.o boards.o config.o constant.o creation.o db.o \
	fight.o guild.o graph.o handler.o house.o interpre.o \
	limits.o magic.o mail.o mobact.o mobcmd.o mobprog.o \
	modify.o objsave.o olc.o password.o race.o random.o religion.o save.o pfile.o \
	shop.o spec_ass.o spec_pro.o spell_pa.o spells.o utils.o \
	weather.o

UTILS = autowiz listrent mudpasswd purgeplay showplay sign split

# Header dependencies are generated by the compiler: -MMD writes a .d file
# listing every header each source file actually includes, and those files
# are pulled in at the bottom of this Makefile.  Editing any header then
# rebuilds exactly the objects that use it.  -MP adds an empty rule for each
# header so that deleting or renaming a header doesn't break the build.
DEPFLAGS = -MMD -MP
DEPFILES = $(OBJFILES:.o=.d) $(patsubst %,util/%.d,$(UTILS))

default: 
	$(MAKE) ../bin/dominion

utils:
	$(MAKE) ../bin/autowiz
	$(MAKE) ../bin/listrent
	$(MAKE) ../bin/mudpasswd
	$(MAKE) ../bin/purgeplay
	$(MAKE) ../bin/showplay
	$(MAKE) ../bin/sign
	$(MAKE) ../bin/split

all: 
	$(MAKE) ../bin/dominion
	$(MAKE) utils

dominion:
	$(MAKE) ../bin/dominion
autowiz:
	$(MAKE) ../bin/autowiz
listrent:
	$(MAKE) ../bin/listrent
mudpasswd:
	$(MAKE) ../bin/mudpasswd
purgeplay:
	$(MAKE) ../bin/purgeplay
showplay:
	$(MAKE) ../bin/showplay
sign:
	$(MAKE) ../bin/sign
split:
	$(MAKE) ../bin/split

# The utilities are each a single source file compiled straight to a binary;
# their dependency files go in util/ (-MF) and name the binary as the target (-MT).
../bin/%: util/%.c Makefile
	$(CC) $(CFLAGS) $(DEPFLAGS) -MF util/$*.d -MT $@ -o $@ $< $(LIBS)

# mudpasswd also needs the password hashing code
../bin/mudpasswd: util/mudpasswd.c password.o pfile.o Makefile
	$(CC) $(CFLAGS) $(DEPFLAGS) -MF util/mudpasswd.d -MT $@ -o $@ util/mudpasswd.c password.o pfile.o $(LIBS)

# these read the player files
../bin/autowiz ../bin/purgeplay ../bin/showplay: ../bin/%: util/%.c pfile.o Makefile
	$(CC) $(CFLAGS) $(DEPFLAGS) -MF util/$*.d -MT $@ -o $@ $< pfile.o $(LIBS)

../bin/dominion : $(OBJFILES)
	$(CC) -o ../bin/dominion $(PROFILE) $(OBJFILES) $(LIBS)

%.o: %.c
	$(CC) -c $(CFLAGS) $(DEPFLAGS) $<

# Changing compiler settings in this file rebuilds everything.
$(OBJFILES): Makefile

clean:
	rm -f *.o *.d util/*.d *~ util/*~ ../bin/dominion $(patsubst %,../bin/%,$(UTILS));

realclean:	clean
	@echo "WARNING!! THIS TARGET IS REMOVING YOUR PLAYER FILE AND PLAYER MAIL FILE!!"
	rm -f ../config.log ../config.status ../config.cache ../lib/etc/players ../lib/etc/plrmail ../lib/etc/mudtime ;

.PHONY: default utils all dominion $(UTILS) clean realclean

-include $(DEPFILES)
